{
  "name": "cc-fallback",
  "version": "0.4.0",
  "description": "Keep Claude Code working when your Claude limit is reached: a local proxy that falls back to free AI APIs, your own APIs and local models, plus CC Desk, a desktop app.",
  "type": "module",
  "bin": {
    "cc-fallback": "bin/cc-fallback.js"
  },
  "files": [
    "bin",
    "src",
    "commands",
    ".claude-plugin",
    "README.md",
    "README.tr.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "desk": "npm --prefix desk install && npm --prefix desk start"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude-code",
    "claude",
    "proxy",
    "ollama",
    "lm-studio",
    "openrouter",
    "gemini",
    "fallback",
    "llm"
  ],
